# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths
DATA_DIR=data
RAW_DATA_PATH=data/raw/dataset.csv
PROCESSED_DATA_PATH=data/processed/processed_data.parquet
MODEL_REGISTRY_DIR=models/checkpoints
MODEL_SAVE_PATH=models/checkpoints/model.joblib

# Active Model Profile (Resolved from conflicting feature branches)
# Options: "production_regularized" (high accuracy, deep trees) | "edge_low_latency" (sub-15ms, light trees)
ACTIVE_MODEL_PROFILE=production_regularized

# Model Reproducibility Parameters
RANDOM_SEED=42
TEST_SPLIT_RATIO=0.2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
